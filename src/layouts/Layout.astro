---
import fetchApi from '../lib/strapi';

const { title, description } = Astro.props;
import '../styles/global.css';

// Fetch Global Config from Strapi
let globalConfig: any = null;
try {
  globalConfig = await fetchApi<any>({
    endpoint: 'global-config',
    query: 'populate=*',
    wrappedByKey: 'data'
  });
} catch (e) {
  console.error("Error fetching global config:", e);
}

const defaultSocials = [
	{ name: 'Facebook', url: 'https://www.facebook.com/Coolhuntingg/', icon: 'M18.77 7.46H14.5v-1.9c0-.9.6-1.1 1-1.1h3V.5h-4.33C10.24.5 9.5 3.44 9.5 5.32v2.14h-3v4h3v12h5v-12h3.85l.42-4z' },
	{ name: 'Instagram', url: 'https://www.instagram.com/coolhuntinggroup/', icon: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z' },
	{ name: 'LinkedIn', url: 'https://es.linkedin.com/company/coolhuntingg', icon: 'M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z' }
];

const iconsMap: Record<string, string> = {
  Facebook: 'M18.77 7.46H14.5v-1.9c0-.9.6-1.1 1-1.1h3V.5h-4.33C10.24.5 9.5 3.44 9.5 5.32v2.14h-3v4h3v12h5v-12h3.85l.42-4z',
  Instagram: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z',
  LinkedIn: 'M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z',
  Twitter: 'M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.84 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z'
};

const socialMedia = globalConfig?.socialLinks?.length > 0
  ? globalConfig.socialLinks.map((s: any) => ({
      name: s.name,
      url: s.url,
      icon: iconsMap[s.icon] || iconsMap.Twitter
    }))
  : defaultSocials;

const footerText = globalConfig?.footerText || "© 2026 Coolhuntingnow";
---

<!doctype html>
<html lang="es" class="bg-brand-dark scroll-smooth overflow-x-hidden">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title || globalConfig?.siteName || 'CoolhuntingNow'}</title>
		
		<!-- SEO BASICS -->
		<meta name="description" content={description || globalConfig?.siteDescription || "CoolhuntingNow - Decoding the DNA of Tomorrow. Plataforma de análisis estratégico y tendencias."} />
		<meta name="keywords" content="coolhunting, tendencias, escenarios futuros, innovación, estrategia, foresight" />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={Astro.url.href} />
		<meta name="theme-color" content="#020617" />
		<meta name="author" content="Coolhunting Group" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800;900&family=Inter:wght@200;300;400;500;700&display=swap" />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800;900&family=Inter:wght@200;300;400;500;700&display=swap" media="print" onload="this.media='all'" />
		<noscript>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800;900&family=Inter:wght@200;300;400;500;700&display=swap" />
		</noscript>
		
		<!-- OPEN GRAPH / SOCIAL META -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url.href} />
		<meta property="og:site_name" content={globalConfig?.siteName || 'CoolhuntingNow'} />
		<meta property="og:title" content={title || globalConfig?.siteName || 'CoolhuntingNow'} />
		<meta property="og:description" content={description || globalConfig?.siteDescription || "CoolhuntingNow - Decoding the DNA of Tomorrow. Plataforma de análisis estratégico."} />
		<meta property="og:image" content={globalConfig?.logo?.url || 'https://res.cloudinary.com/dzldevft6/image/upload/v1776366717/cropped_Coolhunting_Now_3_300x120_cc581925f3.png'} />
		<meta property="og:locale" content="es_ES" />
		
		<!-- TWITTER CARDS -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={Astro.url.href} />
		<meta name="twitter:title" content={title || globalConfig?.siteName || 'CoolhuntingNow'} />
		<meta name="twitter:description" content={description || globalConfig?.siteDescription || "CoolhuntingNow - Decoding the DNA of Tomorrow. Plataforma de análisis estratégico."} />
		<meta name="twitter:image" content={globalConfig?.logo?.url || 'https://res.cloudinary.com/dzldevft6/image/upload/v1776366717/cropped_Coolhunting_Now_3_300x120_cc581925f3.png'} />

	</head>
	<body class="font-inter text-white/90 selection:bg-brand-vibe selection:text-white">
		<!-- Background Layers (Reduced z-index) -->
		<div class="fixed inset-0 -z-50 bg-[#020617]"></div>
		
		<!-- Sticky Header -->
		<header class="fixed top-0 left-0 w-full z-[110] glass border-b border-white/5 bg-slate-950/40 backdrop-blur-xl">
			<nav class="container mx-auto px-6 h-16 md:h-24 flex items-center justify-between">
				<a href="/" class="flex items-center gap-2 group">
					<span class="font-outfit text-2xl font-black tracking-[-0.05em] uppercase italic">Coolhunting<span class="text-brand-cyan">NOW</span></span>
				</a>
				
				<div class="hidden md:flex items-center gap-10 font-outfit font-black text-[13px] uppercase italic tracking-[0.2em]">
					<a href="/" class="nav-link hover:text-brand-cyan transition-colors">Now</a>
					<a href="/insights" class="nav-link hover:text-brand-vibe transition-colors">Insights</a>
					<a href="/metodologia" class="nav-link hover:text-brand-electric transition-colors">Metodología</a>
					<a href="/equipo-coolhunting" class="nav-link hover:text-brand-cyan transition-colors">Equipo</a>
					<a href="/contacto" class="px-8 py-3 bg-white text-black rounded-full hover:bg-brand-cyan hover:text-white transition-all shadow-xl font-outfit font-black uppercase italic tracking-[0.2em] text-[13px]">Acceso</a>
				</div>

				<!-- Botón hamburguesa (solo móvil) -->
				<button id="menu-toggle" class="md:hidden flex flex-col justify-center items-center gap-1.5 w-10 h-10 z-50 relative" aria-label="Abrir menú" aria-expanded="false">
					<span class="menu-bar block w-6 h-0.5 bg-white transition-all duration-300 origin-center"></span>
					<span class="menu-bar block w-6 h-0.5 bg-white transition-all duration-300"></span>
					<span class="menu-bar block w-4 h-0.5 bg-white transition-all duration-300 self-end origin-center"></span>
				</button>
			</nav>
		</header>

		<!-- Drawer móvil — fuera del header para evitar que backdrop-filter cree un containing block -->
		<div id="mobile-menu" class="fixed inset-0 z-[200] flex flex-col translate-x-full transition-transform duration-500 ease-[cubic-bezier(0.23,1,0.32,1)] md:hidden" style="background-color:#020617;background-image:none;" aria-hidden="true">

			<!-- Header del drawer: altura igual al header fijo -->
			<div class="h-16 shrink-0 border-b border-white/10 flex items-center justify-between px-6">
				<span class="font-outfit text-xl font-black tracking-[-0.05em] uppercase italic text-white">Coolhunting<span class="text-brand-cyan">NOW</span></span>
				<button id="menu-close" class="flex flex-col justify-center items-center gap-1.5 w-10 h-10 relative" aria-label="Cerrar menú">
					<span class="block w-6 h-0.5 bg-white rotate-45 translate-y-[4px]"></span>
					<span class="block w-6 h-0.5 bg-white -rotate-45 -translate-y-[4px]"></span>
				</button>
			</div>

			<!-- Links de navegación -->
			<nav class="flex flex-col flex-1 justify-center px-8 gap-1">
				<a href="/" class="mobile-nav-link" data-num="01">Now</a>
				<a href="/insights" class="mobile-nav-link" data-num="02">Insights</a>
				<a href="/metodologia" class="mobile-nav-link" data-num="03">Metodología</a>
				<a href="/equipo-coolhunting" class="mobile-nav-link" data-num="04">Equipo</a>
			</nav>

			<!-- Footer del drawer -->
			<div class="px-8 pb-12 shrink-0 border-t border-white/10 pt-8 flex flex-col gap-4">
				<a href="/contacto" class="w-full px-8 py-4 bg-white text-black rounded-full font-outfit font-black uppercase italic tracking-[0.2em] text-[13px] text-center hover:bg-brand-cyan hover:text-white transition-all">Acceso</a>
				<p class="text-center text-white/70 text-[11px] uppercase tracking-widest font-bold">Decoding the DNA of Tomorrow</p>
			</div>

			<div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none overflow-hidden" aria-hidden="true">
				<span id="menu-bg-num" class="text-[22rem] font-black text-white/[0.02] italic font-outfit transition-all duration-300">01</span>
			</div>
		</div>

		<slot />

		<!-- PREMIUM CYBER FOOTER -->
		<footer class="relative z-10 bg-slate-950 border-t border-white/10 pt-32 pb-20 overflow-hidden">
			<!-- Subtle Background Effect for Footer -->
			<div class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-brand-vibe/5 blur-[150px] pointer-events-none"></div>

			<div class="container mx-auto px-6 relative z-10">
				<div class="flex flex-col items-center text-center">
					
					<!-- Social Media Hub -->
					<div class="flex gap-6 mb-16">
						{socialMedia.map((social: any) => (
							<a href={social.url} target="_blank" rel="noopener noreferrer" aria-label={social.name} class="w-12 h-12 flex items-center justify-center rounded-xl bg-white/[0.03] border border-white/10 hover:border-brand-vibe hover:bg-brand-vibe/10 transition-all group scale-110">
								<svg class="w-5 h-5 fill-white/40 group-hover:fill-brand-vibe transition-colors" viewBox="0 0 24 24">
									<path d={social.icon}></path>
								</svg>
							</a>
						))}
					</div>

					<!-- Secondary Navigation (Main Links) -->
					<div class="flex flex-wrap justify-center items-center gap-x-6 md:gap-x-12 gap-y-6 mb-16 font-outfit text-[13px] font-black uppercase tracking-[0.25em] text-white/65 italic">
						<a href="https://www.coolhuntinguniversity.com/" target="_blank" class="hover:text-brand-cyan transition-colors">Programas de Coolhunting</a>
						<span class="hidden md:block w-px h-4 bg-white/10"></span>
						<a href="https://www.coolhuntinguniversity.com/" target="_blank" class="hover:text-brand-cyan transition-colors">Campus Online</a>
						<span class="hidden md:block w-px h-4 bg-white/10"></span>
						<a href="/insights" class="hover:text-brand-cyan transition-colors">Anticípate al Futuro</a>
					</div>

					<!-- Divider with Branding -->
					<div class="w-full flex items-center gap-8 mb-16 opacity-50">
						<div class="h-px flex-1 bg-gradient-to-r from-transparent to-white/10"></div>
						<img src="https://res.cloudinary.com/dzldevft6/image/upload/v1776639090/cropped_Coolhunting_Now_3_300x120_7adc4cb55c.png" alt="Coolhunting Now" class="h-16 object-contain brightness-0 invert opacity-40 hover:opacity-100 transition-opacity" loading="lazy" />
						<div class="h-px flex-1 bg-gradient-to-l from-transparent to-white/10"></div>
					</div>

					<!-- Legal & Copyright -->
					<div class="flex flex-col md:flex-row items-center gap-4 md:gap-8">
						<div class="flex gap-8 text-[11px] font-black uppercase tracking-widest text-white/70">
							<a href="/privacidad" class="hover:text-white transition-colors">Privacidad</a>
							<a href="/legal" class="hover:text-white transition-colors">Legal</a>
							<a href="/cookies" class="hover:text-white transition-colors">Política de cookies</a>
						</div>
						<span class="hidden md:block w-px h-4 bg-white/5"></span>
						<p class="text-xs font-bold text-white/80 uppercase tracking-widest">
							{footerText}
						</p>
					</div>

				</div>
			</div>
		</footer>

		<style is:global>
			.glass { background: rgba(15, 23, 42, 0.4); backdrop-filter: blur(40px); -webkit-backdrop-filter: blur(40px); }
			@keyframes rotate-slow {
				from { transform: rotate(0deg); }
				to { transform: rotate(360deg); }
			}
			.animate-rotate-slow { animation: rotate-slow 15s linear infinite; }

			/* Menú móvil */
			.mobile-nav-link {
				display: flex;
				align-items: baseline;
				gap: 1rem;
				padding: 1rem 0;
				font-family: 'Outfit', sans-serif;
				font-size: 2.6rem;
				font-weight: 900;
				text-transform: uppercase;
				letter-spacing: -0.04em;
				color: #ffffff;
				border-bottom: 1px solid rgba(255,255,255,0.08);
				transition: all 0.25s ease;
				font-style: italic;
				position: relative;
			}
			.mobile-nav-link::before {
				content: attr(data-num);
				font-size: 0.65rem;
				font-weight: 900;
				letter-spacing: 0.2em;
				color: rgba(255,255,255,0.25);
				font-style: normal;
				transition: color 0.25s ease;
				align-self: center;
				padding-bottom: 2px;
			}
			.mobile-nav-link:active,
			.mobile-nav-link:hover {
				color: #06b6d4;
				padding-left: 0.5rem;
				border-bottom-color: rgba(6,182,212,0.3);
			}
			.mobile-nav-link:active::before,
			.mobile-nav-link:hover::before {
				color: #06b6d4;
			}
			#menu-toggle.is-open .menu-bar:nth-child(1) {
				transform: translateY(8px) rotate(45deg);
			}
			#menu-toggle.is-open .menu-bar:nth-child(2) {
				opacity: 0;
				transform: translateX(-8px);
			}
			#menu-toggle.is-open .menu-bar:nth-child(3) {
				width: 1.5rem;
				transform: translateY(-8px) rotate(-45deg);
				align-self: center;
			}
		</style>

		<script>
			const toggle = document.getElementById('menu-toggle');
			const menu = document.getElementById('mobile-menu');
			const bgNum = document.getElementById('menu-bg-num');

			toggle?.addEventListener('click', () => {
				const isOpen = menu?.getAttribute('aria-hidden') === 'false';
				menu?.setAttribute('aria-hidden', isOpen ? 'true' : 'false');
				toggle.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
				toggle.classList.toggle('is-open', !isOpen);
				menu?.classList.toggle('translate-x-full', isOpen);
				document.body.style.overflow = isOpen ? '' : 'hidden';
			});

			const closeBtn = document.getElementById('menu-close');
			closeBtn?.addEventListener('click', () => {
				menu?.setAttribute('aria-hidden', 'true');
				toggle?.setAttribute('aria-expanded', 'false');
				toggle?.classList.remove('is-open');
				menu?.classList.add('translate-x-full');
				document.body.style.overflow = '';
			});

			menu?.querySelectorAll('a.mobile-nav-link').forEach(link => {
				link.addEventListener('mouseenter', () => {
					if (bgNum) bgNum.textContent = link.getAttribute('data-num') || '01';
				});
				link.addEventListener('click', () => {
					menu.setAttribute('aria-hidden', 'true');
					toggle?.setAttribute('aria-expanded', 'false');
					toggle?.classList.remove('is-open');
					menu.classList.add('translate-x-full');
					document.body.style.overflow = '';
				});
			});

			// Cerrar también con el botón Acceso
			menu?.querySelector('a:not(.mobile-nav-link)')?.addEventListener('click', () => {
				menu.setAttribute('aria-hidden', 'true');
				toggle?.setAttribute('aria-expanded', 'false');
				toggle?.classList.remove('is-open');
				menu.classList.add('translate-x-full');
				document.body.style.overflow = '';
			});
		</script>
	</body>
</html>
