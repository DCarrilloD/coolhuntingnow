const socialMedia = globalConfig?.socialLinks?.length > 0
  ? globalConfig.socialLinks.map((s: any) => ({
      name: s.name,
      url: s.url,
      icon: iconsMap[s.icon] || iconsMap.Twitter
    }))
  : defaultSocials;

const footerText = globalConfig?.footerText || "© 2026 Coolhuntingnow";
---

<!doctype html>
<html lang="es" class="bg-brand-dark scroll-smooth overflow-x-hidden">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="CoolhuntingNow - Decoding the DNA of Tomorrow" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title || globalConfig?.siteName || 'CoolhuntingNow'}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800;900&family=Inter:wght@200;300;400;500;700&display=swap" rel="stylesheet">
		
		<!-- OPEN GRAPH / SOCIAL META -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title || globalConfig?.siteName} />
		<meta property="og:description" content="CoolhuntingNow - Decoding the DNA of Tomorrow" />
		<meta property="og:image" content={globalConfig?.logo?.url || 'https://res.cloudinary.com/dzldevft6/image/upload/v1776366717/cropped_Coolhunting_Now_3_300x120_cc581925f3.png'} />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body class="font-inter text-white/90 selection:bg-brand-vibe selection:text-white">
		<!-- Background Layers (Reduced z-index) -->
		<div class="fixed inset-0 -z-50 bg-[#020617]"></div>
		
		<!-- Sticky Header -->
		<header class="fixed top-0 left-0 w-full z-50 glass border-b border-white/5 bg-slate-950/40 backdrop-blur-xl">
			<nav class="container mx-auto px-6 h-24 flex items-center justify-between">
				<a href="/" class="flex items-center gap-2 group">
					<!-- Dynamic Logo or Default -->
					{globalConfig?.logo?.url ? (
						<img src={globalConfig.logo.url} alt="Logo" class="h-10 w-auto object-contain" />
					) : (
						<div class="relative w-10 h-10 flex items-center justify-center">
							<div class="absolute inset-0 border border-brand-cyan/40 rounded-full animate-rotate-slow"></div>
							<div class="w-2 h-2 bg-brand-cyan rounded-full shadow-[0_0_10px_#06b6d4]"></div>
						</div>
					)}
					<span class="font-outfit text-2xl font-black tracking-[-0.05em] uppercase italic">Coolhunting<span class="text-brand-cyan">NOW</span></span>
				</a>
				
				<div class="hidden md:flex items-center gap-10 font-black text-[11px] uppercase tracking-[0.25em] font-outfit">
					<a href="/" class="nav-link hover:text-brand-cyan transition-colors">Now</a>
					<a href="/insights" class="nav-link hover:text-brand-vibe transition-colors">Insights</a>
					<a href="/metodologia" class="nav-link hover:text-brand-electric transition-colors">Metodología</a>
					<a href="/equipo-coolhunting" class="nav-link hover:text-brand-cyan transition-colors">Equipo</a>
					<a href="/contacto" class="px-8 py-3 bg-white text-black rounded-full hover:bg-brand-cyan hover:text-white transition-all shadow-xl">Acceso</a>
				</div>
			</nav>
		</header>

		<slot />

		<!-- PREMIUM CYBER FOOTER -->
		<footer class="relative z-10 bg-slate-950 border-t border-white/10 pt-32 pb-20 overflow-hidden">
			<!-- Subtle Background Effect for Footer -->
			<div class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-brand-vibe/5 blur-[150px] pointer-events-none"></div>

			<div class="container mx-auto px-6 relative z-10">
				<div class="flex flex-col items-center text-center">
					
					<!-- Social Media Hub -->
					<div class="flex gap-6 mb-16">
						{socialMedia.map((social: any) => (
							<a href={social.url} target="_blank" rel="noopener noreferrer" class="w-12 h-12 flex items-center justify-center rounded-xl bg-white/[0.03] border border-white/10 hover:border-brand-vibe hover:bg-brand-vibe/10 transition-all group scale-110">
								<svg class="w-5 h-5 fill-white/40 group-hover:fill-brand-vibe transition-colors" viewBox="0 0 24 24">
									<path d={social.icon}></path>
								</svg>
							</a>
						))}
					</div>

					<!-- Secondary Navigation (Main Links) -->
					<div class="flex flex-wrap justify-center items-center gap-x-12 gap-y-6 mb-16 font-outfit text-sm font-bold uppercase tracking-[0.2em] text-white/60">
						<a href="https://www.coolhuntinguniversity.com/" target="_blank" class="hover:text-brand-cyan transition-colors">Programas de Coolhunting</a>
						<span class="hidden md:block w-px h-4 bg-white/10"></span>
						<a href="https://www.coolhuntinguniversity.com/" target="_blank" class="hover:text-brand-cyan transition-colors">Campus Online</a>
						<span class="hidden md:block w-px h-4 bg-white/10"></span>
						<a href="/insights" class="hover:text-brand-cyan transition-colors">Anticípate al Futuro</a>
					</div>

					<!-- Divider with Branding -->
					<div class="w-full flex items-center gap-8 mb-16 opacity-50">
						<div class="h-px flex-1 bg-gradient-to-r from-transparent to-white/10"></div>
						<img src={globalConfig?.logo?.url || "https://res.cloudinary.com/dzldevft6/image/upload/v1776366717/cropped_Coolhunting_Now_3_300x120_cc581925f3.png"} alt="Coolhunting Now" class="h-16 object-contain brightness-0 invert opacity-40 hover:opacity-100 transition-opacity" />
						<div class="h-px flex-1 bg-gradient-to-l from-transparent to-white/10"></div>
					</div>

					<!-- Legal & Copyright -->
					<div class="flex flex-col md:flex-row items-center gap-8">
						<div class="flex gap-8 text-[10px] font-black uppercase tracking-widest text-white/20">
							<a href="/privacidad" class="hover:text-white transition-colors">Privacidad</a>
							<a href="/legal" class="hover:text-white transition-colors">Legal</a>
							<a href="/cookies" class="hover:text-white transition-colors">Política de cookies</a>
						</div>
						<span class="hidden md:block w-px h-4 bg-white/5"></span>
						<p class="text-[11px] font-bold text-white/10 uppercase tracking-widest">
							{footerText}
						</p>
					</div>

				</div>
			</div>
		</footer>

		<style is:global>
			.glass { background: rgba(15, 23, 42, 0.4); backdrop-filter: blur(40px); -webkit-backdrop-filter: blur(40px); }
			@keyframes rotate-slow {
				from { transform: rotate(0deg); }
				to { transform: rotate(360deg); }
			}
			.animate-rotate-slow { animation: rotate-slow 15s linear infinite; }
		</style>
	</body>
</html>
