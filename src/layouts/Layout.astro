---
import fetchApi from '../lib/strapi';

const { title } = Astro.props;
import '../styles/global.css';

// Fetch Global Config from Strapi
let globalConfig: any = null;
try {
  globalConfig = await fetchApi<any>({
    endpoint: 'global-config',
    query: 'populate=*',
    wrappedByKey: 'data'
  });
} catch (e) {
  console.error("Error fetching global config:", e);
}

const defaultSocials = [
	{ name: 'Facebook', url: 'https://www.facebook.com/Coolhuntingg/', icon: 'M18.77 7.46H14.5v-1.9c0-.9.6-1.1 1-1.1h3V.5h-4.33C10.24.5 9.5 3.44 9.5 5.32v2.14h-3v4h3v12h5v-12h3.85l.42-4z' },
