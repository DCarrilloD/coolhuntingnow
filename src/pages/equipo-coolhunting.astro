---
import Layout from '../layouts/Layout.astro';
import fetchApi, { optimizeImage } from '../lib/strapi';

// Fetch Team and Ecosystem from Strapi
let strapiTeam: any[] = [];
let strapiEcosystem: any[] = [];
let globalConfig: any = null;

try {
  strapiTeam = await fetchApi<any[]>({
    endpoint: 'equipos',
    query: 'populate=image&sort=order:asc',
    wrappedByKey: 'data'
  });
} catch (e) {
  console.error("Error fetching team:", e);
}

try {
  strapiEcosystem = await fetchApi<any[]>({
    endpoint: 'ecosistemas',
    query: 'sort=id:asc',
    wrappedByKey: 'data'
  });
} catch (e) {
  console.error("Error fetching ecosystem:", e);
}

try {
  globalConfig = await fetchApi<any>({
    endpoint: 'global-config',
    query: 'populate=*',
    wrappedByKey: 'data'
  });
} catch (e) {
  console.error("Error fetching global config:", e);
}

const defaultTeam: any[] = [];
const defaultEcosystem: any[] = [];

const team = strapiTeam?.length > 0 
  ? strapiTeam.map(member => ({
      name: member.name,
      role: member.role,
      specialty: member.specialty,
      image: optimizeImage(member.image?.url, 600)
    }))
  : defaultTeam;

const ecosystem = strapiEcosystem?.length > 0 
  ? strapiEcosystem.map(e => ({
      title: e.title,
      subtitle: e.subtitle,
      description: e.description,
      icon: e.icon || "📡",
      color: e.color || "from-brand-cyan/20",
      link: e.link || "/"
    }))
  : defaultEcosystem;

const president = {
  name: globalConfig?.presidentName || "Manuel Serrano Ortega",
  role: globalConfig?.presidentRole || "President & Founding Visionary",
  bio: globalConfig?.presidentBio || "Representante legal de Coolhunting Consulting Group desde 2008. Su visión ha transformado esta plataforma en un engranaje de inteligencia colectiva estratégico líder en la industria.",
  image: optimizeImage(globalConfig?.presidentImage?.url || "https://res.cloudinary.com/dzldevft6/image/upload/v1776365317/manuel_By_Uc_CX_A_c7d99c4ab0.png", 800),
  linkedin: globalConfig?.presidentLinkedIn || "https://www.linkedin.com/in/manuelserranoortega/",
  portfolio: globalConfig?.presidentPortfolio || "http://manuelserranoortega.com/"
};
---

<Layout 
  title="Equipo | CoolhuntingNow"
  description="El equipo de CoolhuntingNow está formado por expertos en foresight, análisis de tendencias y estrategia, liderados por Manuel Serrano Ortega."
>
  <main class="pt-32 pb-20 md:pb-40 min-h-screen bg-[#020617] relative overflow-hidden">
    
    <!-- DYNAMIC BACKGROUND -->
    <div class="fixed inset-0 z-0 pointer-events-none">
       <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:40px_40px]"></div>
       <div class="absolute top-[-10%] left-[-10%] w-[50%] h-[50%] bg-brand-cyan/10 blur-[120px] rounded-full animate-blob"></div>
       <div class="absolute bottom-[-10%] right-[-10%] w-[50%] h-[50%] bg-brand-electric/10 blur-[120px] rounded-full animate-blob animation-delay-2000"></div>
       <div class="absolute inset-0 bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.1)_50%),linear-gradient(90deg,rgba(255,0,0,0.03),rgba(0,255,0,0.01),rgba(0,0,255,0.03))] bg-[size:100%_4px,3px_100%] opacity-20"></div>
    </div>

    <section class="container mx-auto px-6 relative z-10">
      <!-- INTRO SECTION (REFINED) -->
      <div class="max-w-4xl mx-auto mb-24 animate-fade-in text-center">
        <div class="inline-flex items-center gap-4 mb-8 justify-center w-full">
           <div class="h-px w-12 bg-white/10"></div>
           <span class="text-[10px] font-black uppercase tracking-[0.5em] text-white/65">CoolhuntingNow // Team</span>
           <div class="h-px w-12 bg-white/10"></div>
        </div>
        <h1 class="font-outfit text-[clamp(2.5rem,12vw,10rem)] sm:text-7xl md:text-[10rem] font-black mb-8 tracking-tighter leading-[0.85] text-white italic uppercase">
          Nuestro <span class="text-brand-cyan">Equipo</span>
        </h1>
        <p class="text-xl md:text-2xl text-white/70 font-light leading-relaxed max-w-2xl mx-auto italic">
          Conoce a las increíbles personas que hacen todo esto posible día a día.
        </p>
      </div>

      <!-- Professional Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 sm:gap-x-12 lg:gap-x-16 gap-y-12 sm:gap-y-16 lg:gap-y-24 mb-16 md:mb-32">
        {team.map((member, i) => (
          <div class="group relative card-entrance" style={`--delay: ${i * 100}ms`}>
            <div class="relative w-full max-w-[240px] mx-auto mb-10 group-hover:-translate-y-4 transition-all duration-700 ease-[cubic-bezier(0.23,1,0.32,1)]">
               <div class="absolute -inset-4 border border-white/5 rounded-[4rem] group-hover:border-brand-cyan/30 transition-all duration-500"></div>
               <div class="relative aspect-[4/5] rounded-[3.5rem] overflow-hidden bg-slate-900 shadow-2xl ring-1 ring-white/10 group-hover:ring-brand-cyan/30">
                  <img src={member.image} alt={member.name} class="w-full h-full object-cover grayscale brightness-90 contrast-110 group-hover:grayscale-0 group-hover:brightness-105 group-hover:scale-105 transition-all duration-1000" />
               </div>
            </div>
            <div class="text-center px-4">
               <h3 class="font-outfit text-2xl font-black mb-2 text-white tracking-tight group-hover:text-glow transition-all">{member.name}</h3>
               <p class="text-brand-electric text-[11px] md:text-[13px] font-outfit font-black uppercase italic tracking-[0.2em] opacity-90">{member.specialty}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- MANUEL SERRANO SECTION -->
      <div class="animate-fade-in-up mb-16 md:mb-40">
         <div class="max-w-5xl mx-auto glass p-6 sm:p-10 md:p-16 rounded-[4rem] border border-white/5 relative group hover:border-brand-electric/30 transition-all duration-700 bg-gradient-to-br from-slate-900/40 to-black/60 shadow-2xl overflow-hidden">
            <div class="absolute inset-0 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-1000 bg-gradient-to-r from-transparent via-white/5 to-transparent skew-x-12"></div>
            
            <div class="relative z-10 flex flex-col lg:flex-row gap-8 lg:gap-16 items-center">
               <div class="w-64 h-80 rounded-[4rem] overflow-hidden border border-white/10 bg-slate-950 relative group-hover:border-brand-electric/30 transition-all duration-1000 shrink-0">
                  <img src={president.image} alt={president.name} class="w-full h-full object-cover grayscale brightness-90 group-hover:grayscale-0 group-hover:brightness-105 transition-all duration-1000" />
                  <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-black to-transparent opacity-60"></div>
               </div>
               <div>
                 <span class="text-[11px] md:text-[13px] font-outfit font-black text-brand-electric uppercase italic tracking-[0.3em] mb-4 block">{president.role}</span>
                 <h2 class="font-outfit text-3xl sm:text-4xl md:text-7xl font-black mb-6 tracking-tighter text-white group-hover:text-glow transition-all">{president.name}</h2>
                 <p class="text-xl text-white/70 font-light leading-relaxed mb-10" set:html={president.bio} />
                 <div class="flex flex-wrap gap-4">
                    <a href={president.linkedin} target="_blank" class="btn-primary px-8 py-4 text-[11px] uppercase tracking-widest font-black inline-block">LinkedIn Profile</a>
                    <a href={president.portfolio} target="_blank" class="px-8 py-4 text-[11px] uppercase tracking-widest font-black inline-block border border-white/20 rounded-full hover:bg-white/10 hover:border-white/40 transition-all text-white">View Portfolio</a>
                 </div>
               </div>
            </div>
         </div>
      </div>

      <!-- ECOSYSTEM SECTION -->
      <div id="ecosistema" class="mb-16 md:mb-40 scroll-mt-32">
         <div class="text-center mb-16 max-w-5xl mx-auto">
            <div class="inline-flex items-center gap-4 mb-6 justify-center w-full">
               <div class="h-px w-8 bg-brand-cyan"></div>
               <span class="text-[10px] font-black uppercase tracking-[0.5em] text-brand-cyan">Core Philosophy</span>
               <div class="h-px w-8 bg-brand-cyan"></div>
            </div>
            <h2 class="font-outfit text-3xl sm:text-4xl md:text-7xl font-black mb-10 tracking-tighter text-white uppercase">El Ecosistema</h2>
            <div class="space-y-6 text-white/70 border-y border-white/5 py-10 text-center">
               <p class="text-2xl font-light leading-relaxed">
                  Coolhunting Group no es solo una entidad, es un <strong class="text-white font-bold">ecosistema híbrido diseñado para descodificar el futuro</strong>. 
               </p>
                <p class="text-xl font-light leading-relaxed max-w-4xl mx-auto text-white/70">
                   El valor diferencial reside en un <strong class="text-brand-cyan font-bold">engranaje de inteligencia colectiva</strong> donde la investigación alimenta la formación, y la formación eleva la consultoría.
                </p>
            </div>
         </div>
         
         <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16 md:mb-32">
            {ecosystem.map((entity) => (
               <a href={entity.link} target={entity.link.startsWith('http') ? "_blank" : "_self"} class="glass relative p-10 rounded-[3.5rem] border border-white/5 group hover:border-brand-cyan/30 transition-all duration-700 hover:-translate-y-2 overflow-hidden block">
                  <div class="absolute inset-0 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-1000 bg-gradient-to-r from-transparent via-white/5 to-transparent skew-x-12"></div>
                  <div class="absolute top-8 right-8 text-[8px] font-black uppercase tracking-widest text-brand-cyan opacity-0 group-hover:opacity-100 transition-opacity">Visit Site ↗</div>
                  <div class="relative z-10">
                     <div class="text-5xl mb-6 group-hover:scale-110 transition-all duration-500 inline-block">{entity.icon}</div>
                     <h3 class="font-outfit text-2xl font-black mb-2 group-hover:text-brand-cyan transition-colors">{entity.title}</h3>
                     <p class="text-brand-cyan text-[11px] md:text-[13px] font-outfit font-black uppercase italic tracking-[0.2em] mb-6 opacity-80">{entity.subtitle}</p>
                     <p class="text-lg text-white/65 font-light leading-relaxed">{entity.description}</p>
                  </div>
               </a>
            ))}
         </div>
      </div>

      <!-- HARVARD PARTNERSHIP SECTION -->
      <div class="mb-16 md:mb-40">
         <div class="glass p-6 sm:p-10 md:p-16 rounded-[4rem] border border-white/10 relative overflow-hidden group bg-white/[0.02]">
            <div class="absolute top-0 right-0 w-64 h-64 bg-brand-vibe/10 blur-[100px] pointer-events-none"></div>
            <div class="flex flex-col lg:flex-row items-center gap-12">
               <div class="lg:w-1/3 flex justify-center">
                  <div class="p-6 bg-white rounded-3xl group-hover:scale-105 transition-transform duration-700 shadow-2xl">
                     <img 
                       src="https://res.cloudinary.com/dzldevft6/image/upload/v1776364666/harvard_business_publishing_seeklogo_300x110_103d2ccdb5.png" 
                       alt="Harvard Business Publishing Logo"
                       class="w-56 md:w-72 object-contain"
                     />
                  </div>
               </div>
               <div class="lg:w-2/3">
                  <div class="flex items-center gap-4 mb-4">
                     <span class="w-12 h-px bg-brand-vibe"></span>
                     <h3 class="font-outfit text-3xl md:text-5xl font-black tracking-tighter uppercase">Alianza <br/> <span class="text-brand-vibe">Estratégica</span></h3>
                  </div>
                  <p class="text-xl text-white/60 font-light leading-relaxed">
                     Impulsamos la formación de alto impacto mediante nuestra colaboración con <strong class="text-white font-bold">Harvard Business Publishing</strong>. Inteligencia de negocio para definir el futuro de la gestión empresarial global.
                  </p>
               </div>
            </div>
         </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  @keyframes blob {
    0% { transform: translate(0px, 0px) scale(1); }
    33% { transform: translate(30px, -50px) scale(1.1); }
    66% { transform: translate(-20px, 20px) scale(0.9); }
    100% { transform: translate(0px, 0px) scale(1); }
  }
  .animate-blob { animation: blob 7s infinite alternate; }
  .animation-delay-2000 { animation-delay: 2s; }
  .card-entrance { opacity: 0; animation: slideUp 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards; animation-delay: var(--delay); }
  @keyframes slideUp { from { opacity: 0; transform: translateY(50px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  .text-glow { text-shadow: 0 0 40px rgba(6, 182, 212, 0.4); }
  .glass { background: rgba(15, 23, 42, 0.4); backdrop-filter: blur(40px); -webkit-backdrop-filter: blur(40px); }
</style>
