---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Nosotros | CoolhuntingNow">
  <main class="pt-32 min-h-screen">
    <section class="container mx-auto px-6 py-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-center">
        <div>
          <h1 class="font-outfit text-4xl sm:text-5xl md:text-8xl font-black mb-10 tracking-tighter">
            PROSPECTIVA <br/> <span class="text-brand-vibe">SIN FRONTERAS</span>
          </h1>
          <p class="text-xl text-white/70 mb-10 font-light leading-relaxed">
            Nacimos con una misión clara: convertir las "señales débiles" del presente en la ventaja competitiva del mañana. No solo observamos tendencias; las decodificamos.
          </p>
          <div class="glass p-8 rounded-3xl border-brand-cyan/20">
             <h4 class="text-brand-cyan font-bold mb-4 uppercase tracking-widest text-xs">Nuestra Filosofía</h4>
             <p class="text-white/80 font-light italic">"El futuro no es algo que sucede, es algo que se construye mediante la comprensión profunda de los cambios sistémicos."</p>
          </div>
        </div>
        <div class="relative overflow-hidden rounded-[4rem]">
           <img src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?auto=format&fit=crop&q=80&w=1000" class="rounded-[4rem] glass p-2 rotate-3 hover:rotate-0 transition-transform duration-700" alt="Future lab" />
        </div>
      </div>
    </section>

    <!-- Methodology Cards -->
    <section class="bg-slate-950 py-32 mt-20">
      <div class="container mx-auto px-6 text-center mb-20">
        <h2 class="font-outfit text-4xl md:text-6xl font-bold mb-6">El Método <span class="text-brand-electric">CH-NOW</span></h2>
        <p class="text-white/65 max-w-2xl mx-auto font-light">Un proceso riguroso basado en datos, etnografía y visión estratégica.</p>
      </div>
      
      <div class="container mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12">
        <div class="glass p-8 md:p-12 rounded-[3rem] hover:border-brand-electric transition-colors">
          <div class="text-5xl mb-8 font-black font-outfit text-white/10">01</div>
          <h3 class="text-2xl font-bold mb-6">Escaneo Periférico</h3>
          <p class="text-white/65 font-light leading-relaxed">Rastreamos innovaciones en nichos, startups y movimientos culturales antes de que lleguen al mainstream.</p>
        </div>
        <div class="glass p-8 md:p-12 rounded-[3rem] hover:border-brand-cyan transition-colors">
          <div class="text-5xl mb-8 font-black font-outfit text-white/10">02</div>
          <h3 class="text-2xl font-bold mb-6">Síntesis de Datos</h3>
          <p class="text-white/65 font-light leading-relaxed">Cruzamos hallazgos locales con macro-tendencias globales para validar patrones de consumo reales.</p>
        </div>
        <div class="glass p-8 md:p-12 rounded-[3rem] hover:border-brand-vibe transition-colors">
          <div class="text-5xl mb-8 font-black font-outfit text-white/10">03</div>
          <h3 class="text-2xl font-bold mb-6">Escenarios de Acción</h3>
          <p class="text-white/65 font-light leading-relaxed">Traducimos la información en estrategias accionables que impactan directamente en el P&L de nuestros clientes.</p>
        </div>
      </div>
    </section>

    <!-- Team / Expertise Counter -->
    <section class="py-32 container mx-auto px-6 text-center">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12">
           <div>
              <span class="block text-5xl font-black font-outfit text-brand-electric mb-2">12+</span>
              <span class="text-xs uppercase tracking-widest text-white/60 font-bold">Años Experiencia</span>
           </div>
           <div>
              <span class="block text-5xl font-black font-outfit text-brand-cyan mb-2">500+</span>
              <span class="text-xs uppercase tracking-widest text-white/60 font-bold">Contenidos Publicados</span>
           </div>
           <div>
              <span class="block text-5xl font-black font-outfit text-brand-vibe mb-2">20+</span>
              <span class="text-xs uppercase tracking-widest text-white/60 font-bold">Países Escaneados</span>
           </div>
           <div>
              <span class="block text-5xl font-black font-outfit text-brand-mint mb-2">95%</span>
              <span class="text-xs uppercase tracking-widest text-white/60 font-bold">Precisión Prospectiva</span>
           </div>
        </div>
    </section>
  </main>
</Layout>
