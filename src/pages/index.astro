---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import InsightCard from '../components/InsightCard.astro';

import fetchApi, { optimizeImage } from '../lib/strapi';

// FETCH REAL DESDE STRAPI
let rawInsights: any[] = [];
try {
    rawInsights = await fetchApi<any[]>({
        endpoint: 'insights',
        query: 'populate=*&pagination[pageSize]=3&sort=publishedAt:desc',
        wrappedByKey: 'data'
    }) || [];
} catch (e) {
    console.error("Error fetching insights:", e);
    // Fallback Mock Data
    rawInsights = [
        {
            title: "El Futuro de la Movilidad Urbana",
            slug: "movilidad-urbana",
            category: { name: "Escenarios Futuros" },
            description: "Análisis de cómo las ciudades están rediseñando el transporte post-digital.",
            publishedAt: new Date().toISOString()
        },
        {
            title: "Sostenibilidad Radiactiva",
            slug: "sostenibilidad",
            category: { name: "Tendencias" },
            description: "Nuevos materiales que limpian el aire mientras decoran.",
            publishedAt: new Date().toISOString()
        },
        {
           title: "IA Generativa en Retail",
           slug: "ia-retail",
           category: { name: "Innovación" },
           description: "Cómo los algoritmos están prediciendo el deseo antes que el cliente.",
           publishedAt: new Date().toISOString()
        }
    ];
}

const insights = rawInsights.map(item => ({
    title: item.title,
    slug: item.slug,
    category: item.category?.name || 'General',
    description: item.description,
    cover: optimizeImage(item.coverImage?.url, 800),
    date: new Date(item.publishedAt).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' })
}));

// FETCH PARTNERS (LOGOS)
let partners: any[] = [];
try {
    partners = await fetchApi<any[]>({
        endpoint: 'partners',
        query: 'populate=*',
        wrappedByKey: 'data'
    }) || [];
} catch (e) {
    console.error("Error fetching partners:", e);
}

const ecosystem = [
  {
    title: "Coolhunting University",
    subtitle: "(Business School)",
    link: "https://www.coolhuntinguniversity.com/"
  },
  {
    title: "Coolhunting Group",
    subtitle: "(Consultoría)",
    link: "https://www.coolhunting.pro/"
  },
  {
    title: "Coolhunting Now",
    subtitle: "(📡 Insights)",
    link: "/insights"
  }
];
---

<Layout title="CoolhuntingNow | Decoding the DNA of Tomorrow">
	
	<!-- BACKGROUND MASTER -->
	<div class="fixed inset-0 z-0 pointer-events-none overflow-hidden">
		<div class="absolute inset-0 bg-[#020617]"></div>
		<svg class="absolute inset-0 w-full h-full opacity-[0.03]" xmlns="http://www.w3.org/2000/svg">
			<pattern id="hexagons" width="100" height="173.2" patternUnits="userSpaceOnUse" patternTransform="scale(2) rotate(30)">
				<path d="M50 0 L100 28.8 L100 86.6 L50 115.4 L0 86.6 L0 28.8 Z" fill="none" stroke="white" stroke-width="1" />
			</pattern>
			<rect width="100%" height="100%" fill="url(#hexagons)" />
		</svg>
		<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full text-center hidden md:flex flex-col gap-20 select-none opacity-[0.015]">
			<span class="text-[15rem] font-black uppercase tracking-[1em]">STRATEGY</span>
			<span class="text-[15rem] font-black uppercase tracking-[1em]">FUTURE</span>
			<span class="text-[15rem] font-black uppercase tracking-[1em]">INSIGHTS</span>
		</div>
	</div>

	<div class="relative z-10">
		<Hero />
		
		<!-- BIENVENIDO A COOLHUNTINGNOW (CLEANER INTRO) -->
		<section class="pt-32 pb-16 container mx-auto px-6">
			<div class="max-w-4xl mx-auto border-l-4 border-brand-cyan pl-6 md:pl-12">
				<h2 class="font-outfit text-3xl md:text-4xl font-black mb-8 text-white uppercase tracking-tighter">CoolHuntingNow</h2>
				<p class="text-xl text-white/70 font-light leading-relaxed mb-6">
					Bienvenido a <strong>CoolhuntingNow</strong>, el destino definitivo para profesionales que necesitan entender las corrientes culturales y tecnológicas antes que nadie.
				</p>
				<p class="text-base text-white/60 font-light leading-relaxed">
					Aquí, el conocimiento de <strong>Coolhunting Group</strong> se convierte en contenido: desde señales de innovación hasta escenarios futuros, todo el ecosistema de tendencias en un solo lugar.
				</p>
			</div>
		</section>

		<section class="pt-8 pb-10 md:pt-16 relative overflow-hidden">
			<div class="container mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-8">
				{ecosystem.map((unit, i) => (
					<a href={unit.link} target={unit.link.startsWith('http') ? '_blank' : '_self'} class="glass-card relative p-6 md:p-12 rounded-[2rem] md:rounded-[3.5rem] border border-white/5 group hover:border-brand-cyan/40 transition-all duration-700 hover:-translate-y-2 block text-center overflow-hidden">
						 <!-- ACCENT BAR -->
             <div class="absolute top-0 left-1/2 -translate-x-1/2 w-24 h-1 bg-brand-cyan scale-x-0 group-hover:scale-x-100 transition-transform duration-700 shadow-[0_0_20px_rgba(6,182,212,0.8)]"></div>
             
             <!-- TECH NUMBER -->
             <span class="absolute -bottom-6 -right-4 text-[10rem] font-black text-white/[0.03] select-none pointer-events-none group-hover:text-brand-cyan/5 transition-colors duration-700">0{i+1}</span>
             
             <div class="relative z-10">
               <h4 class="font-outfit text-xl md:text-2xl font-black text-white group-hover:text-brand-cyan transition-colors duration-500 uppercase italic tracking-tighter">{unit.title}</h4>
               <div class="h-px w-8 bg-white/10 mx-auto my-4 group-hover:w-16 transition-all duration-700"></div>
						   <p class="text-[10px] font-black uppercase tracking-[0.4em] text-brand-cyan/40 group-hover:text-white/60 transition-colors">{unit.subtitle}</p>
             </div>

						 <div class="absolute inset-0 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-1000 bg-gradient-to-r from-transparent via-white/5 to-transparent skew-x-12"></div>
					</a>
				))}
			</div>
		</section>

    <!-- PARTNERS / LOGOS SECTION -->
    <section class="pb-32 pt-20">
      <div class="container mx-auto px-6">
        <div class="glass p-6 sm:p-10 md:p-20 rounded-[4rem] border border-white/5 relative overflow-hidden">
          <div class="text-center mb-16">
            <span class="text-[10px] font-black uppercase tracking-[0.5em] text-brand-cyan/60 mb-4 block">Coolhunting Group</span>
            <h3 class="font-outfit text-2xl md:text-4xl font-light text-white tracking-tight leading-snug">
              Impulsamos el talento de los equipos que <br class="hidden md:block"/> 
              <strong class="font-black italic">lideran el mercado</strong>
            </h3>
          </div>
          
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6 md:gap-12 items-center opacity-40 grayscale hover:opacity-100 transition-all duration-1000">
            {partners.length > 0 ? (
              partners.map(p => (
                <img src={optimizeImage(p.logo?.url)} alt={p.name} title={p.name} class="h-10 w-full object-contain filter invert" />
              ))
            ) : (
              <div class="col-span-full py-10">
                <p class="text-white/70 text-xs uppercase tracking-widest italic text-center">Gestiona tus partners desde el admin de Strapi ↗</p>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>

		<!-- VALUE PROPOSITION: ¿QUÉ PUEDE APORTARTE? (DIFFERENTIATING LAYOUT) -->
		<section class="py-24 md:py-56 relative overflow-hidden" id="valor">
			<div class="absolute inset-0 bg-brand-vibe/5 skew-y-3 transform origin-right"></div>
			
			<div class="container mx-auto px-6 relative z-10">
				<!-- Editorial Header -->
				<div class="max-w-4xl mb-10 md:mb-32 flex flex-col md:flex-row gap-10 items-baseline">
					<h2 class="font-outfit text-4xl md:text-[5rem] font-black leading-[0.85] tracking-tighter text-white uppercase italic">
						EL VALOR <br/> DEL <span class="text-brand-vibe">CAMBIO</span>
					</h2>
					<div class="h-px flex-1 bg-gradient-to-r from-brand-vibe to-transparent"></div>
				</div>

				<!-- Staggered Impact Layout -->
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
					
					<!-- Card 1 (Left Offset) -->
					<div class="lg:col-span-7 group">
						<div class="glass-card p-12 md:p-20 rounded-[4rem] border border-white/5 hover:border-brand-vibe/40 transition-all duration-700 relative overflow-hidden">
							<!-- Background Number -->
							<span class="absolute -bottom-10 -right-10 text-[20rem] font-black text-white/[0.02] select-none pointer-events-none group-hover:text-brand-vibe/5 transition-colors">01</span>
							
							<div class="relative z-10">
								<div class="items-center gap-4 mb-10 flex">
									<div class="w-2 h-2 bg-brand-vibe rounded-full animate-ping"></div>
									<span class="text-[10px] font-black uppercase tracking-[0.4em] text-brand-vibe">Reconocimiento_Pro</span>
								</div>
								<p class="text-xl md:text-3xl text-white font-light leading-tight tracking-tight">
									A través del <strong>Coolhunting</strong>, una disciplina emergente y diferenciadora, podrás incrementar tu <strong>reconocimiento laboral</strong> y proyectarte hacia roles de mayor responsabilidad.
								</p>
							</div>
						</div>
					</div>

					<!-- Connecting Gap with Animated Line (Hidden on Mobile) -->
					<div class="hidden lg:flex lg:col-span-1 justify-center items-center">
						<div class="w-px h-full bg-gradient-to-b from-brand-vibe via-brand-vibe to-transparent opacity-20 relative">
							<div class="absolute top-0 left-1/2 -translate-x-1/2 w-4 h-4 bg-brand-vibe rounded-full blur-sm animate-pulse-slow"></div>
						</div>
					</div>

					<!-- Card 2 (Right Offset & Slower) -->
					<div class="lg:col-span-4 mt-8 lg:mt-40 group">
						<div class="bg-brand-vibe/10 backdrop-blur-3xl p-12 md:p-16 rounded-[4rem] border border-brand-vibe/20 hover:border-brand-vibe transition-all duration-1000 relative">
							<span class="absolute -top-10 -left-10 text-[10rem] font-black text-white/[0.02] select-none pointer-events-none">02</span>
							
							<div class="relative z-10">
								<h3 class="text-[10px] font-black uppercase tracking-[0.5em] text-white/65 mb-10">Competitividad_Sistémica</h3>
								<p class="text-2xl md:text-3xl text-white font-light leading-relaxed italic">
									Esta metodología te brinda una <strong>ventaja competitiva esencial</strong> para consolidar tu trayectoria profesional.
								</p>
							</div>
						</div>
					</div>

				</div>
			</div>
		</section>

		<!-- LATEST INSIGHTS (REFINED GRID) -->
		<section class="py-20 md:py-40 relative" id="insights">
			<div class="container mx-auto px-6">
				<div class="flex flex-col md:flex-row justify-between items-end mb-10 md:mb-24 gap-8">
					<div class="max-w-2xl">
						<div class="flex items-center gap-4 mb-8">
						   <div class="h-px w-8 bg-brand-vibe"></div>
						   <span class="text-[9px] font-black uppercase tracking-[0.5em] text-brand-vibe">Current Intelligence</span>
						</div>
						<h2 class="font-outfit text-4xl md:text-6xl lg:text-7xl font-black mb-8 tracking-tighter text-white uppercase italic">Últimos <br/> <span class="text-brand-vibe">Insights</span></h2>
					</div>
					<a href="/insights" class="btn-primary w-full md:w-auto px-10 py-4 md:px-12 md:py-5 text-[10px] uppercase font-black tracking-widest shadow-2xl text-center">Ver Todo el Radar ↗</a>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
					{insights.map(insight => <InsightCard insight={insight} />)}
				</div>
			</div>
		</section>

		<!-- NEWSLETTER CTA -->
		<section class="py-20 md:py-40 container mx-auto px-6">
			<div class="glass p-8 sm:p-12 md:p-32 rounded-[5rem] relative overflow-hidden group border border-white/5 hover:border-brand-cyan/20 transition-all duration-700 shadow-3xl">
				<div class="absolute -top-20 -right-20 w-[600px] h-[600px] bg-brand-cyan/10 blur-[150px] opacity-0 group-hover:opacity-100 transition-opacity duration-1000"></div>
				<div class="absolute -bottom-20 -left-20 w-[600px] h-[600px] bg-brand-vibe/5 blur-[150px] opacity-0 group-hover:opacity-100 transition-opacity duration-1000"></div>
				
				<div class="relative z-10 text-center max-w-4xl mx-auto">
					<h2 class="font-outfit text-3xl sm:text-4xl md:text-8xl font-black mb-6 md:mb-10 tracking-tighter leading-none text-white uppercase">¿LISTO PARA <br/> EL <span class="text-brand-cyan">MAÑANA?</span></h2>
					<p class="text-2xl text-white/65 mb-16 font-light leading-relaxed">
						Únete a nuestra <strong class="text-white font-bold">Trend Letter</strong>. Análisis exclusivo para mentes que diseñan escenarios, no solo que los habitan.
					</p>
					<form class="flex flex-col md:flex-row gap-4 md:gap-6 max-w-2xl mx-auto">
						<input type="email" id="newsletter-email" name="email" autocomplete="email" placeholder="radar@tuempresa.com" class="flex-1 px-8 py-5 md:px-10 md:py-6 rounded-full bg-slate-950/80 border border-white/10 focus:border-brand-cyan outline-none transition-all text-white font-bold backdrop-blur-md" />
						<button class="w-full md:w-auto bg-white text-black px-10 py-5 md:px-12 md:py-6 rounded-full font-black uppercase tracking-widest text-[10px] hover:bg-brand-cyan hover:text-white transition-all shadow-2xl">Acceso VIP ↗</button>
					</form>
				</div>
			</div>
		</section>
	</div>
</Layout>

<style>
  @keyframes scan-x {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100vw); }
  }
  .animate-scan-x { animation: scan-x 3s linear infinite; }

  @keyframes pulse-slow {
	0%, 100% { opacity: 0.3; transform: scale(1); }
	50% { opacity: 0.6; transform: scale(1.1); }
  }
  .animate-pulse-slow { animation: pulse-slow 8s infinite alternate-reverse; }

  .glass { background: rgba(15, 23, 42, 0.4); backdrop-filter: blur(40px); -webkit-backdrop-filter: blur(40px); }
  .glass-card { background: rgba(255, 255, 255, 0.02); backdrop-filter: blur(40px); }
</style>
