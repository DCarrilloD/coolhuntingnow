---
import Layout from '../../layouts/Layout.astro';
import fetchApi from '../../lib/strapi';
import InsightCard from '../../components/InsightCard.astro';

// Componentes de Contenido Dinámico
import EscenarioFuturo from '../../components/content/EscenarioFuturo.astro';
import Estudio from '../../components/content/Estudio.astro';
import Innovacion from '../../components/content/Innovacion.astro';
import Tendencia from '../../components/content/Tendencia.astro';

export async function getStaticPaths() {
    let insights: any[] = [];
    try {
        insights = await fetchApi<any[]>({
            endpoint: 'insights',
            query: 'populate=*',
            wrappedByKey: 'data'
        }) || [];
    } catch (e) {
        console.error("Error in getStaticPaths:", e);
        // Fallback for dev mode
        insights = [{ 
            title: "Insight Placeholder", 
            slug: "placeholder", 
            category: { name: "General" }, 
            description: "Este es un placeholder porque el backend no está disponible.",
            publishedAt: new Date().toISOString()
        }];
    }

    return insights
        .filter((insight) => insight.slug) // Solo procesar los que tengan URL válida
        .map((insight) => ({
            params: { slug: insight.slug },
            props: { insight },
        }));
}

const { insight } = Astro.props;

// Fetch de contenido relacionado
let relatedInsights: any[] = [];
try {
    relatedInsights = await fetchApi<any[]>({
        endpoint: 'insights',
        query: {
            populate: '*',
            'pagination[limit]': 3,
            'filters[slug][$ne]': insight.slug,
            sort: 'publishedAt:desc'
        },
        wrappedByKey: 'data'
    }) || [];
} catch (e) {
    console.error("Error fetching related insights:", e);
}

// MAPEO DE DATOS PARA LAS TARJETAS RELACIONADAS
const mappedRelated = relatedInsights.map(item => ({
    title: item.title,
    slug: item.slug,
    category: item.category?.name || 'General',
    description: item.description,
    cover: item.coverImage?.url || 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&q=80',
    date: new Date(item.publishedAt).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' })
}));


const coverUrl = insight.coverImage?.url || 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&q=80';
---

<Layout title={`${insight.title} | CoolhuntingNow`}>
    <main class="pt-32 pb-20 md:pb-40 min-h-screen bg-slate-950">
        
        <!-- HEADER REFINADO -->
        <header class="max-w-4xl mx-auto px-6 mb-12 animate-fade-in text-center">
            <!-- CATEGORÍA -->
            <div class="flex items-center justify-center gap-4 mb-8">
                <div class="h-px w-8 bg-brand-cyan/30"></div>
                <div class="text-brand-cyan text-[8px] md:text-[10px] font-outfit font-black uppercase tracking-[0.4em] italic opacity-80">
                    {insight.category?.name || 'Insight'} <span class="mx-2 text-white/20">//</span> {new Date(insight.publishedAt).toLocaleDateString('es-ES', { month: 'short', year: 'numeric' })}
                </div>
                <div class="h-px w-8 bg-brand-cyan/30"></div>
            </div>
            
            <!-- TÍTULO IMPACTANTE -->
            <h1 class="font-outfit text-4xl sm:text-5xl md:text-7xl font-black text-white leading-[0.9] uppercase tracking-tighter italic mb-8 drop-shadow-2xl">
                {insight.title}
            </h1>

            <!-- SUBTÍTULO ELEGANTE -->
            <div class="relative max-w-2xl mx-auto mb-12">
                <p class="text-lg md:text-xl text-white/50 font-outfit font-light leading-relaxed italic">
                    {insight.description}
                </p>
                <div class="absolute -bottom-6 left-1/2 -translate-x-1/2 w-12 h-1 bg-gradient-to-r from-brand-cyan via-brand-vibe to-transparent opacity-20"></div>
            </div>

            <!-- IMAGEN PRINCIPAL FLEXIBLE -->
            <div class="relative w-full rounded-3xl overflow-hidden border border-white/10 shadow-[0_0_50px_rgba(0,0,0,0.5)] bg-slate-900/40">
                <img 
                    src={coverUrl} 
                    alt={insight.title} 
                    class="w-full h-auto max-h-[75vh] object-cover md:object-contain transition-all duration-1000"
                />
                <!-- Glass Overlay sutil -->
                <div class="absolute inset-0 pointer-events-none border border-white/5 rounded-3xl"></div>
            </div>
        </header>

        <!-- SEPARADOR -->
        <div class="max-w-3xl mx-auto px-6 mb-4">
            <div class="h-px w-full bg-white/5"></div>
        </div>

        <!-- CONTENIDO DINÁMICO (TEMPLATE ENGINE) -->
        <div class="flex flex-col">
            {insight.content?.map((comp: any) => {
                const categoryName = insight.category?.name?.toLowerCase() || '';
                
                // Si es una tendencia, aplicamos el template de tendencia
                if (comp.__component === 'content.tendencia' || categoryName.includes('tendencia')) {
                    if (comp.__component === 'content.tendencia') return <Tendencia data={comp} />;
                }

                // Si es una innovación
                if (comp.__component === 'content.innovacion' || categoryName.includes('innovacion')) {
                  if (comp.__component === 'content.innovacion') return <Innovacion data={comp} />;
                }

                // Por defecto, si no coincide con la categoría, intentamos renderizar el bloque que sea
                if (comp.__component === 'content.escenario-futuro') return <EscenarioFuturo data={comp} />;
                if (comp.__component === 'content.estudio') return <Estudio data={comp} />;
                if (comp.__component === 'content.innovacion') return <Innovacion data={comp} />;
                if (comp.__component === 'content.tendencia') return <Tendencia data={comp} />;
                
                return null;
            })}
        </div>
        
        <!-- RELACIONADOS (CARRUSEL) -->
        {relatedInsights.length > 0 && (
            <section class="mt-16 md:mt-40 border-t border-white/5 pt-20">
                <div class="container mx-auto px-6">
                    <div class="max-w-4xl mx-auto flex items-end justify-between mb-12">
                        <div>
                            <span class="text-[9px] font-black text-brand-cyan uppercase tracking-[0.5em] block mb-4">Continuar_Exploración</span>
                            <h2 class="text-3xl font-black text-white uppercase italic tracking-tighter">Insights Relacionados</h2>
                        </div>
                        <div class="hidden md:flex gap-2">
                             <button id="prev-related" class="w-12 h-12 rounded-full border border-white/10 flex items-center justify-center hover:bg-white hover:text-black transition-all cursor-pointer group">
                                <span class="group-hover:-translate-x-1 transition-transform">←</span>
                             </button>
                             <button id="next-related" class="w-12 h-12 rounded-full border border-white/10 flex items-center justify-center hover:bg-white hover:text-black transition-all cursor-pointer group">
                                <span class="group-hover:translate-x-1 transition-transform">→</span>
                             </button>
                        </div>
                    </div>
                    
                    <!-- Carrusel Horizontal con Desvanecimiento -->
                    <div class="relative group/carousel">
                        <div id="related-container" class="flex overflow-x-auto gap-8 pb-12 snap-x hide-scrollbar scroll-smooth mask-fade-right">
                            {mappedRelated.map((rel) => (
                                <div class="min-w-[320px] md:min-w-[450px] snap-center">
                                    <InsightCard insight={rel} />
                                </div>
                            ))}
                            <!-- Espaciador final para evitar corte abrupto -->
                            <div class="min-w-[100px] h-full invisible"></div>
                        </div>
                    </div>
                </div>
            </section>
        )}

        <!-- FOOTER MÍNIMO -->
        <section class="max-w-3xl mx-auto px-6 mt-20">
            <div class="p-10 rounded-2xl border border-white/5 text-center">
                <a href="/insights" class="text-[9px] font-black uppercase tracking-widest text-white/20 hover:text-brand-cyan transition-all">
                    ← Volver al Hub de Inteligencia
                </a>
            </div>
        </section>
    </main>
</Layout>

<style>
    @keyframes fade-in {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in { animation: fade-in 0.5s ease-out forwards; }

    .hide-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .hide-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    .mask-fade-right {
        mask-image: linear-gradient(to right, black 80%, transparent 100%);
        -webkit-mask-image: linear-gradient(to right, black 80%, transparent 100%);
    }
</style>

<script>
    const container = document.getElementById('related-container');
    const prevBtn = document.getElementById('prev-related');
    const nextBtn = document.getElementById('next-related');

    if (container && prevBtn && nextBtn) {
        const scrollAmount = 480; // Aproximadamente el ancho de una carta + gap

        prevBtn.addEventListener('click', () => {
            container.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
        });

        nextBtn.addEventListener('click', () => {
            container.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        });

        // Opcional: ocultar flechas si no hay suficiente scroll
        container.addEventListener('scroll', () => {
            const isAtStart = container.scrollLeft === 0;
            const isAtEnd = container.scrollLeft + container.clientWidth >= container.scrollWidth - 10;
            
            prevBtn.style.opacity = isAtStart ? '0.3' : '1';
            nextBtn.style.opacity = isAtEnd ? '0.3' : '1';
        });
    }
</script>
