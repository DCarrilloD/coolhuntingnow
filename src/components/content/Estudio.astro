---
const { data } = Astro.props;
---

<section class="py-24 bg-white/5 border-y border-white/5 backdrop-blur-sm relative overflow-hidden">
    <!-- Grid Pattern BG -->
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 50px 50px;"></div>

    <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-5xl mx-auto">
            <div class="flex flex-col md:flex-row gap-10 md:gap-20">
                <!-- Sidebar Info -->
                <div class="md:w-1/3 space-y-12">
                   <div class="p-8 border border-white/10 rounded-3xl bg-slate-950/50">
                        <div class="text-[10px] font-black uppercase tracking-widest text-brand-electric mb-6">Data_Fact_Sheet</div>
                        <h3 class="text-3xl font-black text-white mb-8 leading-tight">{data.titulo}</h3>
                        <p class="text-white/65 text-sm font-light leading-relaxed mb-8">
                            {data.resumen_estudio}
                        </p>
                        
                        {data.pdf_informe && (
                            <a href={data.pdf_informe.url} class="flex items-center justify-between p-4 bg-white text-black rounded-2xl font-outfit font-black text-[10px] uppercase italic tracking-[0.2em] hover:bg-brand-electric hover:text-white transition-all shadow-xl">
                                Descargar Informe 
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                </svg>
                            </a>
                        )}
                   </div>

                   {data.hashtags && (
                       <div class="flex flex-wrap gap-2 pt-8 border-t border-white/5">
                           {data.hashtags.split(',').map((tag: string) => (
                               <span class="px-4 py-2 bg-white/5 border border-white/10 rounded-full text-[9px] font-outfit font-black uppercase italic tracking-[0.1em] text-white/80 hover:text-brand-electric transition-colors cursor-default">#{tag.trim()}</span>
                           ))}
                       </div>
                   )}
                </div>

                <!-- Main Study Content -->
                <div class="md:w-2/3 space-y-12">
                    <div class="prose prose-invert max-w-none text-white/70 font-outfit font-light leading-[1.8] text-lg tracking-tight selection:bg-brand-electric/30">
                        {data.explicacion}
                    </div>

                    {data.img_principal && (
                        <div class="rounded-3xl overflow-hidden border border-white/10 shadow-2xl">
                             <img src={data.img_principal.url} alt="Study visualization" class="w-full" />
                        </div>
                    )}
                </div>
            </div>
        </div>
    </div>
</section>
