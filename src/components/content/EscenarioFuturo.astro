---
const { data } = Astro.props;
---

<section class="py-24 container mx-auto px-6 overflow-hidden">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-center">
        <!-- Visualization Area -->
        <div class="relative flex justify-center items-center h-[300px] sm:h-[500px]">
             <!-- Hud Rings -->
             <div class="absolute w-[280px] h-[280px] sm:w-[400px] sm:h-[400px] border border-brand-cyan/20 rounded-full animate-[spin_20s_linear_infinite]"></div>
             <div class="absolute w-[240px] h-[240px] sm:w-[350px] sm:h-[350px] border border-dashed border-brand-cyan/40 rounded-full animate-[spin_30s_linear_infinite_reverse]"></div>
             
             <!-- Probability Gauge -->
             <div class="relative z-10 text-center">
                <div class="text-[10px] font-outfit font-black uppercase italic tracking-[0.4em] text-white/30 mb-2">Probabilidad</div>
                <div class="text-[8rem] font-outfit font-black text-brand-cyan leading-none tracking-tighter drop-shadow-[0_0_50px_rgba(6,182,212,0.4)]">
                    {data.probabilidad}<span class="text-3xl font-light">%</span>
                </div>
                <div class="text-xs font-outfit font-black text-white/20 uppercase italic mt-4 tracking-[0.5em]">Calculated_Risk</div>
             </div>

             <!-- Floating Data Points -->
             <div class="absolute top-4 right-4 sm:top-10 sm:right-20 glass px-6 py-3 rounded-full border border-white/10 animate-float text-[10px] font-outfit font-black uppercase italic tracking-widest">
                <span class="text-brand-cyan mr-2">Horizonte:</span> <span class="text-white/80">{data.horizonte}</span>
             </div>
        </div>

        <!-- Content Area -->
        <div class="space-y-8">
            <div class="prose prose-invert max-w-none text-white/70 font-outfit font-light leading-[1.8] text-xl tracking-tight italic">
                <Fragment set:html={data.impacto} />
            </div>

            {data.img_principal && (
                <div class="grid grid-cols-2 gap-4">
                    <div class="h-1 w-full bg-brand-cyan"></div>
                    <div class="h-1 w-full bg-slate-800"></div>
                </div>
            )}
        </div>
    </div>
</section>

<style>
    .glass {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
    }
</style>
