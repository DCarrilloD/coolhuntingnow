---
const { data } = Astro.props;
---

<section class="py-16 relative overflow-hidden">
    <!-- Neon Background Accents -->
    <div class="absolute top-1/2 left-0 w-80 h-80 bg-brand-vibe/5 blur-[120px] rounded-full"></div>
    <div class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-brand-cyan/5 blur-[150px] rounded-full"></div>

    <div class="container mx-auto px-6 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-start">

            <!-- Left: Visual Column -->
            <div class="sm:sticky sm:top-32 space-y-12">
                {data.img_principal && (
                    <div class="relative group">
                        <div class="absolute -inset-1 bg-gradient-to-r from-brand-cyan to-brand-vibe rounded-[2rem] blur opacity-20 group-hover:opacity-40 transition duration-1000"></div>
                        <div class="relative rounded-[2rem] overflow-hidden border border-white/20">
                            <img src={data.img_principal.url} alt="Visualización de innovación" class="w-full grayscale group-hover:grayscale-0 transition-all duration-700" />
                        </div>
                    </div>
                )}

                {data.video_demo && (
                    <a href={data.video_demo} target="_blank" class="block w-full py-6 rounded-full border border-white/10 glass text-center font-outfit font-black uppercase italic text-[10px] tracking-[0.3em] text-white/70 hover:text-white hover:border-brand-cyan transition-all">
                        Ver Video Demostración ▷
                    </a>
                )}
            </div>

            <!-- Right: Analysis Column -->
            <div class="space-y-12">
                <!-- Innovation Metrics: Reubicadas -->
                <div class="grid grid-cols-2 gap-6">
                    {data.estado && (
                        <div class="glass p-6 rounded-3xl border border-brand-cyan/20">
                            <div class="text-[9px] font-outfit font-black uppercase italic tracking-widest text-brand-cyan mb-2">Development_State</div>
                            <div class="text-white font-outfit font-black uppercase italic text-sm tracking-tighter">{data.estado}</div>
                        </div>
                    )}
                    {data.grado_disrupcion && (
                        <div class="glass p-6 rounded-3xl border border-brand-vibe/20">
                            <div class="text-[9px] font-outfit font-black uppercase italic tracking-widest text-brand-vibe mb-2">Disruption_Level</div>
                            <div class="text-white font-outfit font-black uppercase italic text-sm tracking-tighter">{data.grado_disrupcion}</div>
                        </div>
                    )}
                </div>

                <div class="prose prose-invert max-w-none text-white/80 font-outfit font-light leading-[1.8] text-lg tracking-tight">
                    {data.text_principal}
                </div>

                {data.hashtags && (
                    <div class="flex flex-wrap gap-4 pt-8 border-t border-white/5">
                        {data.hashtags.split(',').map((tag: string) => (
                            <span class="text-[10px] font-outfit font-black uppercase italic tracking-[0.2em] text-brand-cyan/40 hover:text-brand-cyan transition-colors">#{tag.trim()}</span>
                        ))}
                    </div>
                )}
            </div>

        </div>
    </div>
</section>

<style>
    .glass {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
    }
</style>
