---
import fetchApi from '../lib/strapi';

// Fetch Home Data from Strapi
let homeData: any = null;
try {
  homeData = await fetchApi<any>({
    endpoint: 'home',
    wrappedByKey: 'data'
  });
} catch (e) {
  console.error("Error fetching home data:", e);
}

const badgeText = homeData?.heroBadge || "Explorando el ADN del Futuro";
const title = homeData?.heroTitle || "DECODIFICANDO <br/> <span class='text-transparent bg-clip-text bg-gradient-to-br from-brand-cyan via-brand-electric to-brand-vibe drop-shadow-[0_0_40px_rgba(6,182,212,0.4)]'>EL MAÑANA</span>, <br/> <span class='italic font-light opacity-90'>HOY.</span>";
const subtitle = homeData?.heroSubtitle || "Accede a <span class='text-white font-bold'>CoolhuntingNow</span>, la plataforma de análisis estratégico de <strong class='text-white font-bold'>Coolhunting Group</strong> para sectores en transformación.";
const btnText = homeData?.heroButtonText || "Entrar en el Hub";
const btnLink = homeData?.heroButtonLink || "/insights";
---

<section class="relative min-h-screen flex items-center pt-24 pb-20 md:pt-32 md:pb-40 overflow-hidden bg-transparent">

  <!-- LOCAL HERO VISUALS -->
  <div class="absolute inset-0 z-0 pointer-events-none">
     <!-- Noise Texture Overlay (Native SVG) -->
     <div class="absolute inset-0 opacity-[0.03] mix-blend-overlay pointer-events-none" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=\'0 0 200 200\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cfilter id=\'n\'%3E%3CfeTurbulence type=\'fractalNoise\' baseFrequency=\'0.65\' numOctaves=\'3\' stitchTiles=\'stitch\'/%3E%3C/filter%3E%3Crect width=\'100%25\' height=\'100%25\' filter=\'url(%23n)\'/%3E%3C/svg%3E');"></div>
     
     <!-- Glow principal — más grande en móvil -->
     <div class="absolute -top-[5%] -left-[10%] w-[500px] h-[500px] md:w-[800px] md:h-[800px] bg-brand-cyan/20 rounded-full blur-[100px] md:blur-[150px] animate-pulse"></div>
     
     <!-- Glow vibe (centro-derecha en móvil) -->
     <div class="absolute top-1/4 -right-20 w-[300px] h-[300px] md:w-[600px] md:h-[600px] bg-brand-vibe/15 rounded-full blur-[80px] md:blur-[120px] animate-pulse" style="animation-delay:2s"></div>
     
     <!-- Vertical Scan Line — Más refinada -->
     <div class="absolute inset-0 bg-gradient-to-b from-transparent via-brand-cyan/30 to-transparent h-[2px] w-full animate-scan-y shadow-[0_0_15px_#06b6d4]"></div>
  </div>

  <div class="container mx-auto px-6 relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
    <!-- TEXT CONTENT -->
    <div class="max-w-4xl text-center lg:text-left">
      <!-- SEO Badge -->
      <div class="inline-flex items-center gap-4 px-6 py-2 rounded-full bg-slate-950/80 border border-white/10 text-brand-cyan text-[11px] md:text-[12px] font-outfit font-black uppercase italic tracking-[0.3em] md:tracking-[0.4em] mb-8 md:mb-10 shadow-[0_0_30px_rgba(6,182,212,0.2)] backdrop-blur-md animate-fade-in-up" style="animation-delay: 0.2s">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-cyan opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-cyan"></span>
        </span>
        {badgeText}
      </div>

      <h1 class="font-outfit text-[clamp(2rem,12vw,3.3rem)] sm:text-6xl md:text-[6.5rem] font-black mb-8 md:mb-10 leading-[0.85] tracking-[-0.06em] text-white uppercase italic animate-fade-in-up" style="animation-delay: 0.4s">
        DECODIFICANDO <br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-brand-cyan to-brand-vibe drop-shadow-[0_0_15px_rgba(6,182,212,0.3)]">EL MAÑANA</span>, <br/>
        <span class="font-light not-italic text-white opacity-80">HOY.</span>
      </h1>

      <div class="relative mb-10 md:mb-14 animate-fade-in-up" style="animation-delay: 0.6s">
        <div class="absolute inset-0 bg-gradient-to-r from-brand-electric/5 to-transparent blur-xl -z-10"></div>
        <h2 class="text-[15px] md:text-2xl text-white/80 font-light leading-relaxed border-l-2 md:border-l-4 border-brand-electric pl-6 md:pl-10 py-4 rounded-r-3xl text-left max-w-2xl mx-auto lg:mx-0" set:html={subtitle} />
      </div>

      <div class="flex flex-col sm:flex-row gap-5 md:gap-8 items-center lg:items-start animate-fade-in-up" style="animation-delay: 0.8s">
        <!-- BOTÓN PRINCIPAL: NEÓN SHINE -->
        <a href={btnLink} class="group relative w-full sm:w-auto px-12 py-5 md:py-6 bg-white text-black font-outfit font-black uppercase italic tracking-[0.2em] text-[13px] rounded-full transition-all hover:scale-105 active:scale-95 shadow-[0_15px_40px_-10px_rgba(6,182,212,0.4)] text-center overflow-hidden">
          <span class="relative z-10">{btnText}</span>
          <!-- Efecto Shine (Barrido) -->
          <div class="absolute inset-0 -translate-x-full group-hover:animate-shine bg-gradient-to-r from-transparent via-white/60 to-transparent skew-x-[-20deg] z-5"></div>
          <!-- Barra inferior de acento -->
          <div class="absolute inset-x-0 bottom-0 h-1.5 bg-gradient-to-r from-brand-cyan via-brand-electric to-brand-vibe transition-all group-hover:h-3"></div>
          <!-- Overlay de gradiente suave -->
          <div class="absolute inset-0 bg-gradient-to-r from-brand-cyan/5 to-brand-vibe/5 opacity-0 group-hover:opacity-100 transition-opacity"></div>
        </a>

        <!-- BOTÓN SECUNDARIO: CYBER GLASS -->
        <a href="/metodologia" class="group relative w-full sm:w-auto px-12 py-5 md:py-6 border border-white/20 rounded-full text-[12px] font-outfit font-bold uppercase italic tracking-[0.25em] text-white/70 hover:text-white transition-all backdrop-blur-2xl text-center overflow-hidden">
          <span class="relative z-10">Ver Metodología</span>
          <!-- Fondo revelado -->
          <div class="absolute inset-0 bg-gradient-to-tr from-brand-cyan/20 to-brand-vibe/20 translate-y-full group-hover:translate-y-0 transition-transform duration-500 ease-out"></div>
          <!-- Borde iluminado -->
          <div class="absolute inset-0 border border-brand-cyan/0 group-hover:border-brand-cyan/50 rounded-full transition-colors shadow-[inset_0_0_20px_rgba(6,182,212,0)] group-hover:shadow-[inset_0_0_20px_rgba(6,182,212,0.2)]"></div>
        </a>
      </div>

      <!-- ORBITAL COMPACTO — Ocultado en móvil por petición del usuario -->
      <div class="hidden justify-center mt-16 relative h-64 animate-fade-in" style="animation-delay: 1s">
        <!-- Glow central intenso -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-40 h-40 bg-brand-cyan/30 blur-[70px] animate-pulse"></div>
        
        <!-- Anillo exterior con glitch sutil -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-56 h-56 border border-brand-cyan/40 rounded-full animate-rotate-slow">
          <div class="absolute -top-1.5 left-1/2 -translate-x-1/2 w-4 h-4 bg-brand-cyan rounded-full shadow-[0_0_25px_#06b6d4]"></div>
        </div>
        
        <!-- Anillo medio pulsante -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-40 h-40 border border-brand-vibe/30 rounded-full animate-ping opacity-20" style="animation-duration: 3s"></div>
        
        <!-- Anillo interior inclinado -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-36 h-36 border border-dashed border-brand-electric/50 rounded-full animate-rotate-reverse" style="transform: translate(-50%,-50%) rotateX(65deg)">
          <div class="absolute top-1/2 -left-1 w-2.5 h-2.5 bg-brand-electric rounded-full shadow-[0_0_15px_#60a5fa]"></div>
        </div>

        <!-- Núcleo CH con Glassmorphism mejorado -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-20 h-20 rounded-[2rem] border border-white/20 flex items-center justify-center rotate-45 overflow-hidden z-10 shadow-[0_0_40px_rgba(255,255,255,0.05)]" style="background: rgba(255,255,255,0.1); backdrop-filter: blur(25px);">
          <div class="absolute inset-0 bg-gradient-to-br from-brand-cyan/30 via-transparent to-brand-vibe/30"></div>
          <span class="text-white font-black text-2xl -rotate-45 relative z-10 drop-shadow-md">CH</span>
          <div class="absolute inset-0 bg-white/10 animate-scan-inner"></div>
        </div>

        <!-- Beams dinámicos -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-72 h-px bg-gradient-to-r from-transparent via-brand-cyan/40 to-transparent rotate-45"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-72 h-px bg-gradient-to-r from-transparent via-brand-vibe/40 to-transparent -rotate-45"></div>
      </div>
    </div>

    <!-- HIGH-CONTRAST ORBITAL CORE — solo desktop -->
    <div class="relative hidden lg:flex justify-center items-center h-[800px]">
       
       <!-- Inner Core (Glow) -->
       <div class="absolute w-40 h-40 bg-brand-cyan/20 blur-[100px] animate-pulse"></div>
       
       <!-- 3D Orbital Rings System -->
       <div class="relative w-[500px] h-[500px] flex items-center justify-center">
          
          <!-- Primary Ring -->
          <div class="absolute inset-0 border-[3px] border-brand-cyan/40 rounded-full animate-rotate-slow shadow-[0_0_40px_rgba(6,182,212,0.2)]">
             <div class="absolute -top-3 left-1/2 -ml-3 w-6 h-6 bg-brand-cyan rounded-full shadow-[0_0_30px_#06b6d4,0_0_10px_#fff]"></div>
          </div>
          
          <!-- Secondary Ring (X-Axis Tilt) -->
          <div class="absolute inset-10 border-[2px] border-brand-vibe/30 rounded-full animate-rotate-reverse group hover:border-brand-vibe transition-colors" style="transform: rotateX(70deg);">
             <div class="absolute top-1/2 -left-2 w-4 h-4 bg-brand-vibe rounded-full shadow-[0_0_20px_#f02aa6]"></div>
          </div>
          
          <!-- Tertiary Ring (Y-Axis Tilt) -->
          <div class="absolute inset-20 border-[1px] border-brand-electric/30 rounded-full animate-rotate-slow" style="transform: rotateY(70deg); animation-duration: 30s;">
             <div class="absolute bottom-0 right-1/2 w-3 h-3 bg-white rounded-full shadow-[0_0_15px_#fff]"></div>
          </div>

          <!-- The Center "Processor" -->
          <div class="relative z-10 w-24 h-24 glass rounded-3xl border-2 border-white/20 flex items-center justify-center rotate-45 group hover:rotate-[225deg] transition-transform duration-1000 overflow-hidden shadow-[0_0_50px_rgba(255,255,255,0.1)]">
             <div class="absolute inset-0 bg-gradient-to-br from-brand-cyan/20 to-brand-vibe/20"></div>
             <div class="text-white font-black text-3xl -rotate-45">CH</div>
             <div class="absolute inset-x-0 top-0 h-1/2 bg-white/20 animate-scan-inner"></div>
          </div>

          <!-- Floating Data Nodes -->
          <div class="absolute top-0 left-0 w-8 h-8 flex items-center justify-center animate-float">
             <div class="w-1.5 h-1.5 bg-brand-cyan rounded-full animate-ping"></div>
          </div>
          <div class="absolute bottom-10 right-20 w-8 h-8 flex items-center justify-center animate-float" style="animation-delay: 2s">
             <div class="w-1.5 h-1.5 bg-brand-vibe rounded-full animate-ping"></div>
          </div>
       </div>

       <!-- High-Energy Beams -->
       <div class="absolute inset-0 z-0 opacity-20 pointer-events-none">
          <div class="absolute top-1/2 left-1/2 w-[800px] h-px bg-gradient-to-r from-transparent via-brand-cyan to-transparent -translate-x-1/2 -translate-y-1/2 rotate-45"></div>
          <div class="absolute top-1/2 left-1/2 w-[800px] h-px bg-gradient-to-r from-transparent via-brand-vibe to-transparent -translate-x-1/2 -translate-y-1/2 -rotate-45"></div>
       </div>

    </div>
  </div>

  <!-- Perspective Mesh Floor (Brighter Contrast) -->
  <div class="absolute bottom-0 left-0 w-full h-60 bg-gradient-to-t from-brand-cyan/20 to-transparent opacity-40 perspective-grid"></div>

</section>

<style>
  :root {
    --brand-cyan: #06b6d4;
    --brand-electric: #60a5fa;
    --brand-vibe: #f02aa6;
  }

  @keyframes scan-y {
    0% { transform: translateY(-100vh); }
    100% { transform: translateY(100vh); }
  }
  .animate-scan-y { animation: scan-y 6s linear infinite; }

  @keyframes shine {
    from { transform: translateX(-150%) skewX(-20deg); }
    to { transform: translateX(150%) skewX(-20deg); }
  }
  .group-hover\:animate-shine { animation: shine 0.7s ease-out; }

  @keyframes scan-inner {
    0% { transform: translateY(-50px); }
    100% { transform: translateY(100px); }
  }
  .animate-scan-inner { animation: scan-inner 2s linear infinite; }

  @keyframes rotate-slow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  @keyframes rotate-reverse {
    from { transform: rotate(360deg); }
    to { transform: rotate(0deg); }
  }
  .animate-rotate-slow { animation: rotate-slow 15s linear infinite; }
  .animate-rotate-reverse { animation: rotate-reverse 10s linear infinite; }

  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up { animation: fade-in-up 0.8s cubic-bezier(0.23, 1, 0.32, 1) forwards; }

  @keyframes float {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(15px, -15px); }
  }
  .animate-float { animation: float 5s ease-in-out infinite; }

  .perspective-grid {
    background-image: 
      linear-gradient(rgba(6, 182, 212, 0.2) 2px, transparent 2px), 
      linear-gradient(90deg, rgba(6, 182, 212, 0.2) 2px, transparent 2px);
    background-size: 80px 80px;
    transform: perspective(400px) rotateX(60deg) scale(2.5);
    mask-image: linear-gradient(to top, black, transparent);
  }

  .glass {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }
</style>
