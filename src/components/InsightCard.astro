---
const { insight } = Astro.props;

// Determine tag color based on category
const getTagColor = (cat) => {
  switch(cat) {
    case 'Escenarios Futuros': return 'text-brand-vibe border-brand-vibe/30 bg-brand-vibe/5';
    case 'Estudios': return 'text-brand-cyan border-brand-cyan/30 bg-brand-cyan/5';
    case 'Innovaciones': return 'text-brand-electric border-brand-electric/30 bg-brand-electric/5';
    case 'Tendencias': return 'text-amber-400 border-amber-400/30 bg-amber-400/5';
    default: return 'text-white/80 border-white/10 bg-white/5';
  }
};

const tagStyles = getTagColor(insight.category);
---
<article class="glass-card rounded-[2.5rem] overflow-hidden group border border-white/5 hover:border-white/20 transition-all duration-700 bg-slate-900/40 relative">
  <!-- Subtle Glow -->
  <div class="absolute inset-0 bg-brand-vibe/0 group-hover:bg-brand-vibe/5 transition-all duration-700 pointer-events-none"></div>

  <div class="relative h-56 sm:h-72 md:h-[22rem] overflow-hidden">
    <img 
      src={insight.cover} 
      alt={insight.title} 
      class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000 grayscale-[0.2] group-hover:grayscale-0" 
      loading="lazy"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#020617] via-transparent to-transparent opacity-60"></div>
    
    <!-- Shimmer Effect -->
    <div class="absolute inset-0 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-1000 bg-gradient-to-r from-transparent via-white/10 to-transparent skew-x-12"></div>

    <div class="absolute top-6 left-6">
        <span class={`px-4 py-1.5 rounded-full border text-[11px] font-outfit font-black uppercase italic tracking-[0.2em] backdrop-blur-md ${tagStyles}`}>
          {insight.category}
        </span>
    </div>
  </div>
  
  <div class="p-10 relative z-10 flex flex-col flex-1">
    
    <a href={`/insights/${insight.slug || '#'}`} class="block group/title">
        <h3 class="font-outfit text-2xl md:text-3xl font-black mb-4 leading-[1.05] text-white group-hover/title:text-brand-vibe transition-colors tracking-tighter uppercase italic">
            {insight.title}
        </h3>
    </a>
    
    <p class="text-white/65 font-light leading-relaxed mb-10 line-clamp-2 text-lg">
      {insight.description}
    </p>
    
    <div class="pt-8 border-t border-white/5 flex items-center justify-between">
      <div class="text-[11px] font-black text-white/70 uppercase tracking-widest italic">
        Report_Data: {insight.date}
      </div>
      
      <a href={`/insights/${insight.slug || '#'}`} class="group/btn relative inline-flex items-center gap-3 overflow-hidden">
        <span class="text-[13px] font-outfit font-black uppercase italic tracking-[0.2em] text-brand-cyan z-10">Read File</span>
        <div class="w-8 h-8 rounded-full bg-brand-vibe/10 flex items-center justify-center group-hover/btn:w-24 group-active/btn:w-24 group-hover/btn:bg-brand-vibe group-active/btn:bg-brand-vibe transition-all duration-500 overflow-hidden relative">
        </div>
      </a>
    </div>
  </div>
</article>

<style>
  .glass-card {
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }
</style>
